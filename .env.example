# ==================== TWILIO CREDENTIALS ====================
# Sign up at https://www.twilio.com and get your credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890  # Your Twilio phone number in E.164 format

# ==================== NEWS API ====================
# Get free API key from https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# ==================== OLLAMA CONFIGURATION ====================
# Local Ollama instance running on your machine
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral  # or neural-chat, openchat, etc.

# ==================== SYSTEM SETTINGS ====================
DEBUG_MODE=False
TEST_MODE=False  # Set to True to test without actual calls
DRY_RUN=False    # Set to True to simulate without calling

# ==================== COQUI TTS (Text-to-Speech) ====================
# These models are downloaded automatically
# Available models: glow-tts (fast), tacotron2 (high quality)
TTS_MODEL_NAME=tts_models/en/ljspeech/glow-tts
